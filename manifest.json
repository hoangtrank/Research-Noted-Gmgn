{
  "manifest_version": 3,
  "name": "Noted for GMGN",
  "version": "0.1.0",
  "description": "Ghi chú research theo timeline cho từng dự án bạn xem trên gmgn.ai: dự án làm gì, tag, pin, mốc thời gian, link X/AI.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "action": {
    "default_title": "Noted for GMGN",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ],
      "js": [
        "src/lib/storage.js",
        "src/lib/editor.js",
        "src/content/gmgn.js"
      ],
      "css": [
        "src/content/gmgn.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-note": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Mở/đóng ghi chú cho token đang xem"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
