{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.9.5",
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.dexscreener.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ],
      "js": [
        "src/lib/storage.js",
        "src/lib/i18n.js",
        "src/lib/research.js",
        "src/lib/editor.js",
        "src/content/sites/gmgn.js",
        "src/content/core.js"
      ],
      "css": [
        "src/content/badge.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dexscreener.com/*"
      ],
      "js": [
        "src/lib/storage.js",
        "src/lib/i18n.js",
        "src/lib/research.js",
        "src/lib/editor.js",
        "src/content/sites/dexscreener.js",
        "src/content/core.js"
      ],
      "css": [
        "src/content/badge.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/search*",
        "https://twitter.com/search*"
      ],
      "js": [
        "src/lib/storage.js",
        "src/lib/i18n.js",
        "src/lib/research.js",
        "src/lib/editor.js",
        "src/content/sites/xsearch.js",
        "src/content/core.js"
      ],
      "css": [
        "src/content/badge.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/i/grok*",
        "https://twitter.com/i/grok*",
        "https://grok.com/*"
      ],
      "js": [
        "src/lib/storage.js",
        "src/lib/i18n.js",
        "src/content/grok.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-note": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "__MSG_cmdToggle__"
    }
  }
}
